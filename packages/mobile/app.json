{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.framewave_k7x2.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://framewa-qghvtoz-preview-4200.runable.site/",
      "applicationId": "framewa-qghvtoz",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.framewave_k7x2.runable",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "name": "Framewave",
    "slug": "framewave",
    "version": "1.0.0",
    "scheme": "runable-framewa-qghvtoz",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-video"
    ]
  }
}
